# life-node.env: the only per-node file. Put it on the boot partition of a freshly flashed card (any laptop
# can write that FAT partition); at the first boot it moves to /data/life-node/env and leaves the boot
# partition. Edit it later over SSH at /data/life-node/env and restart the timers.
NODE_HOSTNAME=life-node-1                # the node answers to <hostname>.local on the desk network (mDNS)
NODE_PASSWORD=                          # replaces the image's default SSH password for user "life" (default: lifebox); set one
NODE_SSH_KEY=                           # optional: one public key, in single quotes because it has spaces:
#   NODE_SSH_KEY='ssh-ed25519 AAAA... you@laptop'; then the password can stay unset
NODE_LAT=52.3838                        # the place, for BirdNET's species range filter
NODE_LON=4.9014
LIFE_API=https://life.oncra.org/api/v1
LIFE_DEVICE_TOKEN=lo_dev_...            # SOUND device (BirdNET pushes)
LIFE_DEVICE_TOKEN_SOIL_1=lo_dev_...     # 10 cm probe, Modbus address 1
LIFE_DEVICE_TOKEN_SOIL_2=lo_dev_...     # 30 cm probe, Modbus address 2 (both ship as 1: re-address one first, see README)
RS485_PORT=/dev/ttyUSB0
PROBE_ADDRESSES=1,2
PROBE_PROFILE=sen0600
LIFE_POST_BATCH=3                       # only for the soil agent run on its own; on the node life-push posts the soil queue
LIFE_MIN_CONFIDENCE=0.5                 # detections below this stay on the node
SCHEDULE=season                         # season (the network's listening schedule, see the README) | bench (15 min in every hour) | none (stays on, for the desk)
OFFWINDOW_GRACE_MIN=10                  # season: a node the Witty Pi woke by itself outside its windows posts and powers off this long after boot
CLOCK_WAIT=180                          # seconds to wait for a time sync at boot before trusting the Witty Pi's RTC
# bench only: a WiFi to join. The field node has the 4G stick and no WiFi; leave these empty there.
WIFI_SSID=
WIFI_PSK=
WIFI_COUNTRY=NL                         # regulatory country for the WiFi radio
# the 4G APN (iot.1nce.net) is set once in the stick's own web UI at http://192.168.8.1, not here
MODEM_HOST=192.168.8.1                  # the heartbeat reads the serving cell from the stick's web API; empty = no modem
NODE_TZ=Europe/Amsterdam                # local clock time for the Witty Pi schedule
WITTYPI_DEFAULT_ON=1                    # the Witty Pi switches the Pi on as soon as power arrives; 0 = wait for its K1 button
WITTYPI_LOW_V=12.6                      # battery guard: the Witty Pi shuts the Pi down cleanly below this at its input; 0 = off (a mains adapter)
WITTYPI_RECOVERY_V=13.2                 # after such a stop it switches the Pi on again above this (the panel charging); off with the guard
LIFE_BIRD_MIC=audiomoth                 # audiomoth (birds and bats on the AudioMoth, the I2S microphone its witness by day) | i2s (birds on the I2S microphone, the AudioMoth for bats) | both (the two compared)
LIFE_TEST_SOURCES=                      # with both: AudioMoth, so the AudioMoth's birds go out as test while the two are compared (the I2S witness is always test)
LIFE_MIC_CHECK=1                        # 0: no witness and no daily level check of the two microphones
GUARD=0                                 # 1 when the tamper guard board is fitted (node/firmware/life-guard); lid/panel/tilt contacts, siren
LIFE_TAILSCALE=0                        # bench only: 1 = reachable from anywhere over Tailscale while on the cable or the WiFi, never the SIM (node/apply-tailscale.sh); 0 in a field
# clips (life-clips): the sound an expert checks, kept on the card; it never goes over the SIM
LIFE_KEEP_CLIPS=1                       # 0: no clips at all (BirdNET-Go's export off, every clip on the node deleted)
LIFE_CLIPS_ALL_FROM=0.5                 # every clip from this score up is kept while the card has room; below it a sample per score band
LIFE_CLIPS_SECONDS=7                    # each kept clip is cut to this many seconds from the start of the detection
LIFE_CLIPS_MIN_FREE_MB=2000             # with less free on /data only the band sample still grows (the owner's page says a visit is due)
LIFE_CLIPS_UPLOAD=1                     # 1: the node sends its clips itself while on the cable or a WiFi; 0: only a visit or a stick takes them
LIFE_LIVE=1                             # 1: on the cable or a WiFi the node posts how it is doing every 20 s for its dashboard (life-live), never over 4G; 0: never
LIFE_LIVE_PUSH_S=120                    # while live, the detections and the soil go out this often (seconds; 0: only with the heartbeat)
# visits (life-visit): a magnet on the visit contact, or the Witty Pi's button, and the clips leave over the visitor's
# phone hotspot or onto the Life Clips app on a laptop. The hotspot's name and password are set on the node's page.
LIFE_VISIT=1                            # 0: the button is only the button; 1: it starts a visit, and outside the windows the node powers off after it
LIFE_VISIT_PIN=                         # 22 once the visit contact is fitted (header pin 15); empty without one, or a loose pin could start visits
VISIT_MAX_MIN=30                        # a visit ends after this many minutes (at most 60)
VISIT_HOTSPOT_WAIT_S=90                 # how long the node looks for the visitor's hotspot before it opens its own WiFi
# settings over the air (life-config): the oracle may set a few of the settings above (the node's page lists them,
# within fixed bounds); they go into a block at the end of this file that only life-config writes, and win over the
# lines above. Clear one on the node's page and the node's own value counts again.
