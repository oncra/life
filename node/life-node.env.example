# life-node.env: the only per-node file. Put it on the boot partition of a freshly flashed card (any laptop
# can write that FAT partition); at the first boot it moves to /data/life-node/env and leaves the boot
# partition. Edit it later over SSH at /data/life-node/env and restart the timers.
NODE_HOSTNAME=life-node-1                # the node answers to <hostname>.local on the desk network (mDNS)
NODE_PASSWORD=                          # replaces the image's default SSH password for user "life" (default: lifebox); set one
NODE_SSH_KEY=                           # optional: one public key, in single quotes because it has spaces:
#   NODE_SSH_KEY='ssh-ed25519 AAAA... you@laptop'; then the password can stay unset
NODE_LAT=52.3838                        # the place, for BirdNET's species range filter
NODE_LON=4.9014
LIFE_API=https://life.oncra.org/api/v1
LIFE_DEVICE_TOKEN=lo_dev_...            # SOUND device (BirdNET pushes)
LIFE_DEVICE_TOKEN_SOIL_1=lo_dev_...     # 10 cm probe, Modbus address 1
LIFE_DEVICE_TOKEN_SOIL_2=lo_dev_...     # 30 cm probe, Modbus address 2 (both ship as 1: re-address one first, see README)
RS485_PORT=/dev/ttyUSB0
PROBE_ADDRESSES=1,2
PROBE_PROFILE=sen0600
LIFE_POST_BATCH=3                       # only for the soil agent run on its own; on the node life-push posts the soil queue
LIFE_MIN_CONFIDENCE=0.5                 # detections below this stay on the node
SCHEDULE=season                         # season (the network's listening schedule, see the README) | bench (15 min in every hour) | none (stays on, for the desk)
OFFWINDOW_GRACE_MIN=10                  # season: a node the Witty Pi woke by itself outside its windows posts and powers off this long after boot
CLOCK_WAIT=180                          # seconds to wait for a time sync at boot before trusting the Witty Pi's RTC
# bench only: a WiFi to join. The field node has the 4G stick and no WiFi; leave these empty there.
WIFI_SSID=
WIFI_PSK=
WIFI_COUNTRY=NL                         # regulatory country for the WiFi radio
# the 4G APN (iot.1nce.net) is set once in the stick's own web UI at http://192.168.8.1, not here
MODEM_HOST=192.168.8.1                  # the heartbeat reads the serving cell from the stick's web API; empty = no modem
NODE_TZ=Europe/Amsterdam                # local clock time for the Witty Pi schedule
WITTYPI_DEFAULT_ON=1                    # the Witty Pi switches the Pi on as soon as power arrives; 0 = wait for its K1 button
WITTYPI_LOW_V=12.6                      # battery guard: the Witty Pi shuts the Pi down cleanly below this at its input; 0 = off (a mains adapter)
WITTYPI_RECOVERY_V=13.2                 # after such a stop it switches the Pi on again above this (the panel charging); off with the guard
GUARD=0                                 # 1 when the tamper guard board is fitted (node/firmware/life-guard); lid/panel/tilt contacts, siren
