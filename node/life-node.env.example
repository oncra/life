# /etc/life-node.env  (written by provision.sh; one file per node)
LIFE_API=https://life.oncra.org/api/v1
LIFE_DEVICE_TOKEN=lo_dev_...            # SOUND device (BirdNET pushes)
LIFE_DEVICE_TOKEN_SOIL_1=lo_dev_...     # 10 cm probe
LIFE_DEVICE_TOKEN_SOIL_2=lo_dev_...     # 30 cm probe
RS485_PORT=/dev/ttyUSB0
PROBE_ADDRESSES=1,2                     # both probes ship as address 1: re-address one to 2 (register 0x07D0) first
PROBE_PROFILE=sen0600
APN=iot.1nce.net
