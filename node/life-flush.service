[Unit]
Description=Life node: flush queued readings and detections before power is cut
DefaultDependencies=no
Before=shutdown.target
After=network-online.target
[Service]
Type=oneshot
EnvironmentFile=/etc/life-node.env
Environment=LIFE_HEARTBEAT_EVENT=shutdown
Environment=LIFE_SOIL_QUEUE=/var/lib/life-node/queue.jsonl
# life-push carries the soil queue on its one connection; the soil agent then only posts what that left behind
ExecStart=-/usr/local/bin/life-push
ExecStart=/usr/local/bin/life-soil-agent --flush
TimeoutStartSec=90
[Install]
WantedBy=shutdown.target
