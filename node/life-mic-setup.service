[Unit]
Description=Life node: the AudioMoth at its rate, and BirdNET-Go's microphones and models to match, before it starts
# after life-schedule has set the clock: until then a node's clock reads the image's date, and the bat model's hours
# would be worked out for that night (node 1 ran the bat model for the first four minutes of every dawn window)
After=life-firstboot.service life-clips-setup.service systemd-udev-settle.service life-schedule.service
Before=birdnet-go.service
RequiresMountsFor=/data
[Service]
Type=oneshot
EnvironmentFile=/etc/life-node.env
ExecStart=/usr/local/bin/life-mic setup
TimeoutStartSec=90
[Install]
WantedBy=multi-user.target
