# copy to /opt/life/.env on the server
POSTGRES_PASSWORD=CHANGE_ME
ADMIN_API_KEY=CHANGE_ME_LONG_RANDOM
SITE_URL=https://life.oncra.org
# Caddy site address. Use the hostname once DNS points here; before that use e.g. ":80" (plain http on the IP)
SITE_HOST=life.oncra.org
# More hostnames on the same instance: comma-separated, e.g. "life.oncra.org, lifebox.oncra.org" (the build plan host)
# optional: where node alerts (silent, moved) are pushed as JSON {title, body, url, tag} with a bearer token.
# Any endpoint of that shape will do (a push relay, ntfy behind a proxy, a chat webhook adapter).
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
# the code a visitor needs to queue an "AI change" on the build plan (lifebox.oncra.org); leave empty to disable
LIFEBOX_ACCESS_CODE=
